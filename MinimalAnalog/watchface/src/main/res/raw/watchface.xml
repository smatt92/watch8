<?xml version="1.0"?>
<!--
    Minimal Analog - a Watch Face Format v4 watch face for Galaxy Watch 8 (Wear OS 6).

    Watch Face Format is declarative XML only. There is no rendering code in
    this project and none is ever to be added; see CLAUDE.md.

    Canvas is 450x450, the WFF authoring canvas, which the platform scales to
    the physical display. Hand geometry is generated by tools/gen_assets.py;
    re-run it if the hand sizes change, and copy the attributes it prints.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#ff000000">

    <!-- Hour markers. Vector shapes, so they cost no bitmap memory. -->
    <Group name="ticks" x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="128" />
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="0">
        <RoundRectangle x="221" y="17" width="8" height="26" cornerRadiusX="4" cornerRadiusY="4">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="30">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="60">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="90">
        <RoundRectangle x="221" y="17" width="8" height="26" cornerRadiusX="4" cornerRadiusY="4">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="120">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="150">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="180">
        <RoundRectangle x="221" y="17" width="8" height="26" cornerRadiusX="4" cornerRadiusY="4">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="210">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="240">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="270">
        <RoundRectangle x="221" y="17" width="8" height="26" cornerRadiusX="4" cornerRadiusY="4">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="300">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
      <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="330">
        <RoundRectangle x="223" y="17" width="4" height="14" cornerRadiusX="2" cornerRadiusY="2">
          <Fill color="#ff969696" />
        </RoundRectangle>
      </PartDraw>
    </Group>

    <!-- Date: short weekday plus day of month, e.g. "MON 15". -->
    <PartText name="date" x="125" y="95" width="200" height="38" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="140" />
      <Localization calendar="GREGORIAN" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="#ffaaaaaa">
          <Template>%s %d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Step count for the current day. -->
    <PartText name="steps" x="125" y="317" width="200" height="38" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="140" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="#ffaaaaaa">
          <Template>%d STEPS<Parameter expression="[STEP_COUNT]" /></Template>
        </Font>
      </Text>
    </PartText>

    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="214" y="105" width="22" height="150"
        pivotX="0.5" pivotY="0.8" tintColor="#ffffffff" />
      <MinuteHand resource="minute" x="217" y="50" width="16" height="200"
        pivotX="0.5" pivotY="0.875" tintColor="#ffffffff" />
      <!-- Ambient variant: the second hand is removed entirely. -->
      <SecondHand resource="second" x="218" y="35" width="14" height="230"
        pivotX="0.5" pivotY="0.8260869565" tintColor="#ffff4438" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Sweep frequency="SYNC_TO_DEVICE" />
      </SecondHand>
    </AnalogClock>

    <!-- Centre cap, drawn over the hands. Hidden in ambient with the second hand. -->
    <PartDraw name="cap" x="218" y="218" width="14" height="14" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Ellipse x="0" y="0" width="14" height="14">
        <Fill color="#ffff4438" />
      </Ellipse>
    </PartDraw>

  </Scene>
</WatchFace>
