<?xml version="1.0"?>
<!--
    MERIDIAN - Watch Face Format v2, 450x450.

    Geometry and colour both reconciled against the supplied design data. Values
    the design did not state still carry an [INFERRED] comment on the line that
    uses them.

    Ambient colour is carried by paired elements, one per state, crossfaded with
    alpha 255->0 and 0->255. The design's ambient literals are not reachable by
    dimming the interactive colour: #F2EFE6 at alpha 140 over black gives
    #85837E, not #6F6C66, and no single alpha reproduces the literal (the three
    channels would need 117, 115 and 113).

    Layer order below is L0..L9 as specced. Two deliberate deviations, both
    instructed:
      - complication slots are 76px, not 52px, so SHORT_TEXT does not clip;
      - ambient outlines are 2px strokes, dimmed by fill, never by thinning.

    Reconciled against the design data. readout_date stays on the centreline as
    instructed, but at the real design centre (225,75) the minute hand does not
    reach it — there is no collision left to keep. See the note on that element.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <!-- L0 bg_black -->
  <Scene backgroundColor="#ff000000">

    <!-- L1 ring_minute_60. One static drawable, not 60 elements.
         Dropped entirely in ambient. -->
    <PartImage name="ring_minute_60" x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="ring_minute_60" />
    </PartImage>

    <!-- L2 ring_hour_12 + index_12_double.
         Two elements per layer: the solid pass is interactive-only, the
         outline pass is ambient-only. WFF cannot swap a `resource` in a
         Variant, so the swap is done by crossfading two elements. -->
    <PartImage name="ring_hour_12" x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="ring_hour_12" />
    </PartImage>
    <PartImage name="ring_hour_12_amb" x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Image resource="ring_hour_12_outline" />
    </PartImage>

    <!-- index_12_double 18x26, centred (225,29) -> box 216,16. From design. -->
    <PartImage name="index_12_double" x="216" y="16" width="18" height="26" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="index_12_double" />
    </PartImage>
    <PartImage name="index_12_double_amb" x="216" y="16" width="18" height="26" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Image resource="index_12_double_outline" />
    </PartImage>

    <!-- L3 slot_a / slot_b. Centres at r=146 on the 9 and 3 o'clock axis:
         slot_a (79,225), slot_b (371,225). Diameter raised 52 -> 76 per
         instruction, so the boxes are 41,187 and 333,187.
         supportedTypes lists exactly the types that have a <Complication>
         renderer below, matching the Complications sample, which declares and
         renders 1:1. A type declared without a renderer is selectable but
         draws nothing. EMPTY needs no renderer.
         Default providers avoid duplicating the date and steps readouts.
         slot_b is SUNRISE_SUNSET rather than UNREAD_NOTIFICATION_COUNT, which
         reads "0" most of the time and looks broken on first install. -->
    <ComplicationSlot name="slot_a" slotId="13"
        x="41" y="187" width="76" height="76" alpha="255"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY"
        displayName="slot_left" isCustomizable="TRUE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY"
          defaultSystemProviderType="SHORT_TEXT" />
      <BoundingOval x="0" y="0" width="76" height="76" outlinePadding="2.0" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="22" width="76" height="32">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="plex_mono_medium" size="22" weight="MEDIUM" color="#fff2efe6">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartImage x="22" y="22" width="32" height="32">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <ComplicationSlot name="slot_b" slotId="14"
        x="333" y="187" width="76" height="76" alpha="255"
        supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE EMPTY"
        displayName="slot_right" isCustomizable="TRUE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="SUNRISE_SUNSET"
          defaultSystemProviderType="SHORT_TEXT" />
      <BoundingOval x="0" y="0" width="76" height="76" outlinePadding="2.0" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="22" width="76" height="32">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="plex_mono_medium" size="22" weight="MEDIUM" color="#fff2efe6">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
        <PartImage x="22" y="22" width="32" height="32">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Slot rings are drawn in BOTH states, per the design colour table:
         #3A3A38 interactive, #2B2B2B ambient. Paired elements carry the literal
         colours rather than dimming one by alpha. Vector, so no bitmap cost. -->
    <PartDraw name="slot_a_ring" x="41" y="187" width="76" height="76" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Ellipse x="1" y="1" width="74" height="74">
        <Stroke color="#ff3a3a38" thickness="2" />
      </Ellipse>
    </PartDraw>
    <PartDraw name="slot_a_ring_amb" x="41" y="187" width="76" height="76" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Ellipse x="1" y="1" width="74" height="74">
        <Stroke color="#ff2b2b2b" thickness="2" />
      </Ellipse>
    </PartDraw>
    <PartDraw name="slot_b_ring" x="333" y="187" width="76" height="76" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Ellipse x="1" y="1" width="74" height="74">
        <Stroke color="#ff3a3a38" thickness="2" />
      </Ellipse>
    </PartDraw>
    <PartDraw name="slot_b_ring_amb" x="333" y="187" width="76" height="76" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Ellipse x="1" y="1" width="74" height="74">
        <Stroke color="#ff2b2b2b" thickness="2" />
      </Ellipse>
    </PartDraw>

    <!-- L4 readout_date. Centre (225,75), font 15, from design. At these
         coordinates the minute hand tip (y=119 at :00) clears the box bottom
         (y=87) by 32px — the collision my inferred y=120 produced is not in
         the real design. [INFERRED] box height 24 and the DAY_OF_WEEK_S + DAY
         content; the design gives a centre and a font size, not a box. -->
    <PartText name="readout_date" x="145" y="63" width="160" height="24" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Localization calendar="GREGORIAN" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="plex_mono_medium" size="15" weight="MEDIUM" color="#fff2efe6">
          <Template>%s %d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /></Template>
        </Font>
      </Text>
    </PartText>
    <PartText name="readout_date_amb" x="145" y="63" width="160" height="24" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Localization calendar="GREGORIAN" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="plex_mono_medium" size="15" weight="MEDIUM" color="#ff6f6c66">
          <Template>%s %d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /></Template>
        </Font>
      </Text>
    </PartText>

    <!-- L5 readout_steps. The design splits this into TWO elements: a value at
         (225,357) font 26 and a label at (225,383) font 11. My manifest had one.
         [INFERRED] box heights 34 / 18, and the label string "STEPS"; the design
         gives centres and font sizes only. -->
    <PartText name="readout_steps_value" x="145" y="340" width="160" height="34" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="plex_mono_medium" size="26" weight="MEDIUM" color="#ffff7a33">
          <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
        </Font>
      </Text>
    </PartText>
    <PartText name="readout_steps_value_amb" x="145" y="340" width="160" height="34" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="plex_mono_medium" size="26" weight="MEDIUM" color="#ff6f6c66">
          <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
        </Font>
      </Text>
    </PartText>
    <!-- Dropped entirely in ambient, not dimmed: no ambient twin. -->
    <PartText name="readout_steps_label" x="145" y="374" width="160" height="18" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER" ellipsis="TRUE">
        <Font family="plex_mono_medium" size="11" weight="MEDIUM" color="#ff7d7a74">STEPS</Font>
      </Text>
    </PartText>

    <AnalogClock x="0" y="0" width="450" height="450">
      <!-- L6 hand_hour 8x76. [INFERRED] no tail, so pivotY=1.0 and the drawable
           sits x=221,y=149. Solid pass + ambient outline pass. -->
      <HourHand resource="hand_hour" x="221" y="149" width="8" height="76"
        pivotX="0.5" pivotY="1.0" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0" />
      </HourHand>
      <HourHand resource="hand_hour_outline" x="221" y="149" width="8" height="76"
        pivotX="0.5" pivotY="1.0" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255" />
      </HourHand>

      <!-- L7 hand_minute. 6x106, a confirmed deviation from the design data's
           4x106: at 4px a 2px ambient outline leaves zero interior and the
           outline reads as solid. 6px leaves a 2px interior. Both states share
           the same geometry; only outline vs fill differs. -->
      <MinuteHand resource="hand_minute" x="222" y="119" width="6" height="106"
        pivotX="0.5" pivotY="1.0" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0" />
      </MinuteHand>
      <MinuteHand resource="hand_minute_outline" x="222" y="119" width="6" height="106"
        pivotX="0.5" pivotY="1.0" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255" />
      </MinuteHand>

      <!-- L8 hand_second. 14x142: 2px shaft, 14px counterweight disc centred on
           the pivot, 30px tail beyond. Height, pivot and centre are unchanged
           from the design row; only the width widens (2 -> 14), so the box x
           moves 224 -> 218 to keep the centre on 225. Dropped in ambient. -->
      <SecondHand resource="hand_second" x="218" y="113" width="14" height="142"
        pivotX="0.5" pivotY="0.7887323944" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Sweep frequency="SYNC_TO_DEVICE" />
      </SecondHand>
    </AnalogClock>

    <!-- L9 cap. Interactive is a #FF7A33 ring on a #000000 centre: the black
         fill punches through the orange counterweight disc baked into
         hand_second.png, leaving the donut. Ambient is a flat #8D8A82 disc.
         Paired elements carry the literal colours.
         [INFERRED] 14px outer diameter and the 2px ring thickness; the design
         table gives colours and a shape, not a stroke width. -->
    <PartDraw name="cap" x="218" y="218" width="14" height="14" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Ellipse x="1" y="1" width="12" height="12">
        <Fill color="#ff000000" />
        <Stroke color="#ffff7a33" thickness="2" />
      </Ellipse>
    </PartDraw>
    <PartDraw name="cap_amb" x="218" y="218" width="14" height="14" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Ellipse x="0" y="0" width="14" height="14">
        <Fill color="#ff8d8a82" />
      </Ellipse>
    </PartDraw>

  </Scene>
</WatchFace>
